# Leave all Firebase values empty to use the fully functional local-device mode.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# App configuration
VITE_APP_NAME=FoodOrder

# Initial defaults only — locale and currency are runtime settings in code
# (src/state/deviceConfig.ts); users change them anytime from Settings.
VITE_DEFAULT_LOCALE=en
VITE_DEFAULT_CURRENCY=EGP

# Set to true to force local-device mode even when Firebase values exist (used by E2E).
VITE_FORCE_LOCAL_MODE=

# Contact form email delivery (Vercel serverless function).
# Configure real values as Sensitive environment variables in Vercel.
CONTACT_EMAIL_ENABLED=
CONTACT_EMAIL_FROM=
CONTACT_EMAIL_TO=
CONTACT_RATE_LIMIT_MAX=3
CONTACT_RATE_LIMIT_WINDOW_MS=3600000
CONTACT_SMTP_HOST=
CONTACT_SMTP_PORT=587
CONTACT_SMTP_SECURE=false
CONTACT_SMTP_USER=
CONTACT_SMTP_PASS=

# Required for branded SMTP password-reset delivery. Store this JSON as a
# Sensitive Vercel environment variable; never commit a service-account key.
# `FIREBASE_SERVICE_ACCOUNT` is accepted as a compatibility alias for the
# repository secret with that name. Configure only one of these JSON variables.
FIREBASE_SERVICE_ACCOUNT_JSON=
