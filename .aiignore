# Paths an AI agent must not search, read, or index.
#
# Searching these wastes tokens and round-trips without ever changing a
# decision: they are generated, vendored, or capture artifacts. Prefer
# `git ls-files` for discovery, which honours .gitignore and skips most of
# this automatically.

node_modules/
functions/node_modules/
dist/
build/
coverage/
.vercel/
.firebase/

# Native platform projects: generated by Capacitor, thousands of files.
android/
ios/

# Test and capture artifacts.
playwright-report/
test-results/
ui-shots/
screenshots/
videos/

# Agent scratch space and worktrees.
.claude/
.worktrees/
.ai/local/
.ai/context/

# Lockfiles: enormous, and never the answer to a code question.
package-lock.json
functions/package-lock.json
